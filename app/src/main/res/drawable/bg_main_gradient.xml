<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#1FB9A2"
                android:endColor="#F58A3D"
                android:startColor="#0A6AA6"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:left="-80dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#00FFFFFF"
                android:startColor="#4DFFFFFF" />
            <size
                android:width="260dp"
                android:height="260dp" />
        </shape>
    </item>

    <item
        android:bottom="-180dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#00FFF5D6"
                android:startColor="#66FFE29E" />
            <size
                android:width="320dp"
                android:height="320dp" />
        </shape>
    </item>
</layer-list>
